# ---- Explanation layer (Gemini Flash, free tier) ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000

# ---- Storage ----
DATABASE_URL=sqlite:///./storage/stitchai.db

# ---- Model / inference ----
DEVICE=cuda            # cuda | cpu
CLIP_CHECKPOINT=ViT-L-14-336  # backbone checkpoint tag used by AnomalyCLIP
DEFAULT_THRESHOLD=0.5   # fallback confidence threshold if not set per-category in config.yaml

# ---- Misc ----
LOG_LEVEL=INFO
